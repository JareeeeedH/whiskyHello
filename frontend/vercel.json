{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(whiskies|sommelier|privacy|terms|login|register|forgot-password|profile|admin)",
      "destination": "/index.html"
    },
    { "source": "/admin/(users|reviews)", "destination": "/index.html" },
    { "source": "/whiskies/:id(\\d+)", "destination": "/index.html" }
  ]
}
