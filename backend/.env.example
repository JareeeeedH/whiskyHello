PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/whiskyhello
# Required in production (no fallback). Development may omit and use a local default.
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (dev default: Vite)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# development | production
NODE_ENV=development
# Set to 1/true only behind a trusted reverse proxy (enables Express trust proxy = 1)
# TRUST_PROXY=1
# Optional auth rate-limit max attempts per window (prod default 20, otherwise 100)
# AUTH_RATE_LIMIT_MAX=20
# Google Identity Services client ID (required for POST /auth/google)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
