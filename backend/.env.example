PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/whiskyhello
# Dedicated database for `npm test` only (required by integration tests; never falls back to MONGODB_URI).
# Must differ from MONGODB_URI and its database name must contain "test".
# Local example: docker run -d --name whiskyhello-mongo-test -p 127.0.0.1:27017:27017 mongo:7
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/whiskyhello_test
# Required in production (no fallback). Development may omit and use a local default.
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (dev default: Vite)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# development | production
NODE_ENV=development
# Set to 1/true only behind a trusted reverse proxy (enables Express trust proxy = 1)
# TRUST_PROXY=1
# Optional auth rate-limit max attempts per window (prod default 20, otherwise 100)
# AUTH_RATE_LIMIT_MAX=20
# Google Identity Services client ID (required for POST /auth/google)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OpenAI (AI Sommelier preference extraction, critic review translation). Backend only — never expose to the frontend.
# Sommelier: required only when a request includes freeText; otherwise OpenAI is not called.
# Translation: required for uncached translations; cached translations are served without OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=
