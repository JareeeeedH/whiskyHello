VITE_API_BASE_URL=http://localhost:3000/api/v1
# Optional. Default `/` (Vercel/local). GitHub Pages build uses `npm run build:gh-pages` → `/whiskyHello/`.
# VITE_BASE_PATH=/whiskyHello/
# Google Identity Services client ID (public; must match backend GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
